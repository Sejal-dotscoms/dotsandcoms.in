<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdoutLogEnabled="true"  → turn ON while diagnosing 500.30, then set back to false.
        The server must have a "logs" folder next to the DLL, writable by the IIS app pool identity.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\Dotsandcoms-in.Server.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
